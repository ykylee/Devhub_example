# v0.2.0 PoC — Environment variable template (umbrella doc §3.3 + §3.6 + §11)
# Copy to .env and adjust. None of these are required for PoC mock mode.

# Path Y caller-provided user context (umbrella doc §3.6.1)
PATH_Y_MAX_AGE_SECONDS=300

# Runtime data directory (umbrella doc §2.1)
VAR_DIR=./var

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Gitea integration (mock mode if GITEA_URL or GITEA_TOKEN missing)
# GITEA_URL=http://localhost:3000
# GITEA_TOKEN=<gitea_access_token>
GITEA_DEFAULT_OWNER=devhub
GITEA_DEFAULT_REPO=example

# 봉투 암호화 KEK (AES-256-GCM, 32 byte base64)
# None이면 plaintext mode (PoC default)
# RAW_ENCRYPTION_KEY=

# Audit log
AUDIT_LOG_RETENTION_DAYS=7

# Monitoring
ENABLE_METRICS=false
