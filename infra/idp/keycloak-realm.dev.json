{
  "id": "devhub",
  "realm": "devhub",
  "enabled": true,
  "displayName": "DevHub Local Testing (dev-only — DO NOT import into production)",
  "eventsListeners": [ "jboss-logging", "devhub-event-listener" ],
  "sslRequired": "none",
  "registrationAllowed": false,
  "roles": {
    "realm": [
      {
        "name": "user",
        "description": "DevHub User Role"
      }
    ]
  },
  "groups": [
    {
      "name": "devhub-users",
      "path": "/devhub-users",
      "realmRoles": [ "user" ]
    }
  ],
  "clients": [
    {
      "clientId": "devhub-frontend",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost/devhub/*",
        "http://localhost:3000/*",
        "http://localhost:3000/auth/callback",
        "http://localhost:3000/devhub/auth/callback",
        "http://localhost:8080/devhub/*",
        "http://localhost:13000/*",
        "http://localhost:13000/devhub/*",
        "http://localhost:13000/devhub/auth/callback"
      ],
      "webOrigins": [
        "+",
        "http://localhost:3000",
        "http://localhost",
        "http://localhost:8080",
        "http://localhost:13000"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost/devhub/*##http://localhost:3000/*##http://localhost:3000/##http://localhost:3000/devhub/##http://localhost:8080/devhub/*##http://localhost:13000/*##http://localhost:13000/devhub/*"
      },
      "protocolMappers": [
        {
          "name": "audience-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "devhub-frontend",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "employee_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "employee_id",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "employee_id",
            "jsonType.label": "String",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "devhub-backend",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "secret-change-me-backend",
      "serviceAccountsEnabled": true,
      "directAccessGrantsEnabled": false,
      "authorizationServicesEnabled": false
    }
  ],
  "users": [
    {
      "username": "service-account-devhub-backend",
      "enabled": true,
      "serviceAccountClientId": "devhub-backend",
      "clientRoles": {
        "realm-management": [
          "view-users",
          "manage-users",
          "view-events",
          "view-realm",
          "manage-realm",
          "view-clients"
        ]
      }
    }
  ]
}
