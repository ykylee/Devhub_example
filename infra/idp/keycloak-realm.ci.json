{
  "id": "devhub",
  "realm": "devhub",
  "enabled": true,
  "eventsListeners": [
    "jboss-logging",
    "devhub-event-listener"
  ],
  "sslRequired": "none",
  "registrationAllowed": false,
  "roles": {
    "realm": [
      {
        "name": "user",
        "description": "DevHub User Role"
      }
    ]
  },
  "clients": [
    {
      "clientId": "devhub-frontend",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:3000/*"
      ],
      "webOrigins": [
        "http://localhost:3000"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/*##http://localhost:3000/"
      },
      "protocolMappers": [
        {
          "name": "devhub-frontend-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "devhub-frontend",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "devhub-backend",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "secret-change-me-backend",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "authorizationServicesEnabled": false
    }
  ],
  "users": [
    {
      "username": "service-account-devhub-backend",
      "enabled": true,
      "serviceAccountClientId": "devhub-backend",
      "clientRoles": {
        "realm-management": [
          "view-users",
          "query-users",
          "manage-users",
          "view-realm"
        ]
      }
    }
  ]
}
