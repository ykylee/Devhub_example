{
  "id": "devhub",
  "realm": "devhub",
  "enabled": true,
  "displayName": "DevHub Local Testing",
  "eventsListeners": [ "jboss-logging", "devhub-event-listener" ],
  "sslRequired": "external",
  "registrationAllowed": false,
  "roles": {
    "realm": [
      {
        "name": "developer",
        "description": "DevHub Developer Role"
      },
      {
        "name": "manager",
        "description": "DevHub Manager Role"
      },
      {
        "name": "pmo_manager",
        "description": "DevHub PMO Manager Role"
      },
      {
        "name": "system_admin",
        "description": "DevHub System Administrator Role"
      }
    ]
  },
  "groups": [
    {
      "name": "devhub-developers",
      "path": "/devhub-developers",
      "realmRoles": [ "developer" ]
    },
    {
      "name": "devhub-managers",
      "path": "/devhub-managers",
      "realmRoles": [ "manager" ]
    },
    {
      "name": "devhub-pmo-managers",
      "path": "/devhub-pmo-managers",
      "realmRoles": [ "pmo_manager" ]
    },
    {
      "name": "devhub-system-admins",
      "path": "/devhub-system-admins",
      "realmRoles": [ "system_admin" ]
    }
  ],
  "clients": [
    {
      "clientId": "devhub-frontend",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "https://*/devhub/*",
        "http://*/devhub/*",
        "http://localhost:3000/*",
        "http://localhost:3000/auth/callback",
        "http://localhost:3000/devhub/auth/callback"
      ],
      "webOrigins": [
        "+",
        "http://localhost:3000"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://*/devhub/*##http://*/devhub/*##http://localhost:3000/*##http://localhost:3000/##http://localhost:3000/devhub/"
      },
      "protocolMappers": [
        {
          "name": "audience-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "devhub-frontend",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "employee_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "employee_id",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "employee_id",
            "jsonType.label": "String",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "devhub-backend",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "secret-change-me-backend",
      "serviceAccountsEnabled": true,
      "directAccessGrantsEnabled": false,
      "authorizationServicesEnabled": false
    }
  ],
  "users": [
    {
      "username": "service-account-devhub-backend",
      "enabled": true,
      "serviceAccountClientId": "devhub-backend",
      "clientRoles": {
        "realm-management": [
          "view-users",
          "manage-users",
          "view-events",
          "view-realm",
          "manage-realm",
          "view-clients"
        ]
      }
    }
  ]
}
