# DevHub nginx reverse-proxy template — single-port ingress (ADR-0018) + Keycloak 단일 IdP (ADR-0019)
#
# 본 파일은 nginx 공식 이미지의 envsubst 템플릿 entrypoint 가 처리한다 (compose 의
# /etc/nginx/templates/ mount → /etc/nginx/conf.d/*.conf 로 변환).
#
# 치환 환경변수 (compose 의 nginx 서비스 environment 에서 주입):
#   ${KEYCLOAK_UPSTREAM}              Keycloak upstream host:port
#                                      - 로컬 모드 (compose local-idp profile)  : keycloak:8080
#                                      - 외부 모드 (사내 운영 Keycloak)         : kc.internal.example.com:8443
#   ${KEYCLOAK_ADMIN_ALLOW_CIDR}      Keycloak Admin REST API 접근 허용 CIDR (예: 10.0.0.0/8)
#                                      - 빈 값이면 admin path 외부 노출 차단 안 함 (기본은 internal-only 권장)
#
# 자세한 사용 SOP 는 infra/nginx/README.md 참조.

upstream devhub_frontend {
    server frontend:3000;
}

upstream devhub_backend_core {
    server backend-core:8080;
}

# Keycloak upstream — 로컬 / 외부 모드 분기 지점.
upstream devhub_keycloak {
    server ${KEYCLOAK_UPSTREAM};
}

server {
    listen 80 default_server;
    server_name _;
    absolute_redirect off;
    resolver 127.0.0.11 ipv6=off;
    set $frontend_upstream http://frontend:3000;

    client_max_body_size 20m;
    # Large OIDC headers/cookies (IdP + upstream auth chain) can exceed nginx defaults.
    proxy_buffer_size 32k;
    proxy_buffers 8 32k;
    proxy_busy_buffers_size 64k;

    location = /nginx-health {
        access_log off;
        add_header Content-Type text/plain;
        return 200 'ok';
    }

    # Legacy root-level auth routes — friendly 302 to canonical /devhub/* entries.
    location = /login {
        return 302 /devhub/login;
    }
    location = /auth/callback {
        return 302 /devhub/auth/callback$is_args$args;
    }
    location = /auth/logout {
        return 302 /devhub/auth/logout$is_args$args;
    }

    # ANTI-PATTERN — DO NOT ADD `location /api/ { proxy_pass backend; }` (PR #398 close 사례).
    # ADR-0018 sub-path 격리 정책상 DevHub backend traffic 은 canonical `/devhub/api/`
    # 만 노출한다. shared hostname 의 다른 서비스가 root `/api/*` 를 쓸 수 있어 collision
    # 위험. frontend client 가 `/api/v1/...` 를 root 로 호출하면 root cause 는 build 시점
    # 의 `NEXT_PUBLIC_BASE_PATH=devhub` 누락 — nginx 우회가 아니라 그 build env 정합이 정공법.
    # 자세한 가이드: `docs/setup/docker-packaging-deployment-guide.md` (BASE_PATH 섹션).

    # Frontend runtime config route (Next.js app/api/runtime-config).
    location = /devhub/api/runtime-config {
        proxy_pass $frontend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # X-Forwarded-Host = host:port 그대로 ($http_host) — Next.js 의 request.nextUrl.origin
        # 이 본 헤더 우선 사용. 누락 시 internal listen port (:3000) 또는 :80 default 로
        # 인식되어 OIDC redirect_uri 가 외부 ingress port (예: :13000) 가 아닌 :80 으로
        # 잘못 생성되는 회귀 (사용자 보고 2026-05-26).
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }

    # Some pre-basePath frontend bundles still reference root /_next assets.
    location /_next/ {
        proxy_pass $frontend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # X-Forwarded-Host = host:port 그대로 ($http_host) — Next.js 의 request.nextUrl.origin
        # 이 본 헤더 우선 사용. 누락 시 internal listen port (:3000) 또는 :80 default 로
        # 인식되어 OIDC redirect_uri 가 외부 ingress port (예: :13000) 가 아닌 :80 으로
        # 잘못 생성되는 회귀 (사용자 보고 2026-05-26).
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # Frontend root entry under /devhub.
    location = /devhub {
        return 302 /devhub/developer;
    }
    location = /devhub/ {
        return 302 /devhub/developer;
    }

    # `/devhub/api/*` 를 backend `/api/*` 로 전달.
    location /devhub/api/ {
        rewrite ^/devhub/api/(.*)$ /api/$1 break;
        proxy_pass http://devhub_backend_core;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # X-Forwarded-Host = host:port 그대로 ($http_host) — Next.js 의 request.nextUrl.origin
        # 이 본 헤더 우선 사용. 누락 시 internal listen port (:3000) 또는 :80 default 로
        # 인식되어 OIDC redirect_uri 가 외부 ingress port (예: :13000) 가 아닌 :80 으로
        # 잘못 생성되는 회귀 (사용자 보고 2026-05-26).
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # Keycloak Admin REST API — internal-only (carve G — P3 정합).
    # 본 location 은 /devhub/auth/keycloak/ 의 일반 location 보다 우선 매칭되어야 하므로
    # location ^~ (prefix 가장 우선 매칭) 로 선언한다. ${KEYCLOAK_ADMIN_ALLOW_CIDR} 미지정
    # (빈 값) 시 deny all 만 적용 → 외부 차단 + backend 는 keycloak:8080 직접 통신 사용.
    location ^~ /devhub/auth/keycloak/admin/ {
        allow ${KEYCLOAK_ADMIN_ALLOW_CIDR};
        deny all;

        proxy_pass http://devhub_keycloak;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # X-Forwarded-Host = host:port 그대로 ($http_host) — Next.js 의 request.nextUrl.origin
        # 이 본 헤더 우선 사용. 누락 시 internal listen port (:3000) 또는 :80 default 로
        # 인식되어 OIDC redirect_uri 가 외부 ingress port (예: :13000) 가 아닌 :80 으로
        # 잘못 생성되는 회귀 (사용자 보고 2026-05-26).
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Prefix /devhub/auth/keycloak;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }

    # Keycloak OIDC public endpoints (authorize / token / userinfo / .well-known / logout).
    # backend Keycloak Admin Client (devhub-backend service account) 는 internal network 의 keycloak:8080 직접 호출.
    # 사용자 (browser) 의 OIDC flow 만 본 path 로 reverse proxy.
    location /devhub/auth/keycloak/ {
        # Keycloak 이 own URL 생성 시 basePath (KC_HTTP_RELATIVE_PATH=/devhub/auth/keycloak) 포함 가정.
        proxy_pass http://devhub_keycloak;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # X-Forwarded-Host = host:port 그대로 ($http_host) — Next.js 의 request.nextUrl.origin
        # 이 본 헤더 우선 사용. 누락 시 internal listen port (:3000) 또는 :80 default 로
        # 인식되어 OIDC redirect_uri 가 외부 ingress port (예: :13000) 가 아닌 :80 으로
        # 잘못 생성되는 회귀 (사용자 보고 2026-05-26).
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Prefix /devhub/auth/keycloak;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }

    location /devhub/ {
        proxy_pass $frontend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Prefix /devhub;
        proxy_redirect off;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    location = / {
        return 302 /devhub;
    }
}
