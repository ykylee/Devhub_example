# DevHub production deploy env template (docker-compose.deploy.yml)
#
# 본 example 은 **prod 환경 = 외부 모드 강제** (사내 운영팀의 PostgreSQL + Keycloak instance).
# DB_MODE=external + COMPOSE_PROFILES 미설정 — db / keycloak 컨테이너 가동 절대 금지.
# 분기 매트릭스: docs/setup/internal_network_constraints.md §4 (prod row).
#
# Copy to .env.prod and fill values for your production environment.

# Image
IMAGE_TAG=replace-with-prod-release-tag
IMAGE_REPO_PREFIX=ghcr.io/ykylee/devhub_example

# Nginx
NGINX_HTTP_PORT=80
DEVHUB_PUBLIC_BASE_URL=https://devhub.example.com

# Mode = external (prod 강제). COMPOSE_PROFILES 절대 설정 금지.
DB_MODE=external

# External Keycloak / internal-only admin access
KEYCLOAK_UPSTREAM=kc-prod.internal.example.com:8443
KEYCLOAK_ADMIN_ALLOW_CIDR=10.0.0.0/8

# App / DB
DB_URL=postgres://devhub_prod:replace-me@db-prod.internal.example.com:5432/devhub_prod?sslmode=require
BACKEND_API_URL=http://backend-core:8080
BACKEND_AI_URL=http://backend-ai:8000
DEVHUB_AUTH_DEV_FALLBACK=0
# prod 는 무조건 gate enabled. 0 으로 두지 말 것.
DEVHUB_ONBOARDING_GATE_ENABLED=1
DEVHUB_TRUSTED_PROXIES=172.16.0.0/12

# Project management model (PR #312). prod 는 hybrid → v2 단계적 전환 권장.
DEVHUB_PROJECT_MODEL=hybrid

# Proxy (사내 운영 환경) — host build 단계 자연 전파, docker daemon proxy 별도 설정.
# HTTP_PROXY=http://proxy.internal.example.com:8080
# HTTPS_PROXY=http://proxy.internal.example.com:8080
# NO_PROXY=localhost,127.0.0.1,*.internal.example.com

# OIDC / Keycloak
DEVHUB_IDP_PROVIDER=keycloak
DEVHUB_OIDC_ISSUER_URL=https://devhub.example.com/devhub/auth/keycloak/realms/devhub
DEVHUB_OIDC_CLIENT_ID=devhub-frontend
DEVHUB_OIDC_CLIENT_SECRET=replace-me
DEVHUB_OIDC_AUDIENCE=devhub-frontend
# Recommended when backend cannot resolve/reach public issuer host directly.
DEVHUB_OIDC_JWKS_URL=https://kc-prod.internal.example.com/devhub/auth/keycloak/realms/devhub/protocol/openid-connect/certs
DEVHUB_KEYCLOAK_ADMIN_URL=https://kc-prod.internal.example.com/devhub/auth/keycloak
DEVHUB_KEYCLOAK_ADMIN_REALM=devhub
DEVHUB_KEYCLOAK_ADMIN_CLIENT_ID=devhub-backend
DEVHUB_KEYCLOAK_ADMIN_CLIENT_SECRET=replace-me

# Frontend runtime OIDC
NEXT_PUBLIC_BASE_PATH=devhub
OIDC_ISSUER_URL=https://devhub.example.com/devhub/auth/keycloak/realms/devhub
OIDC_AUTH_URL=
OIDC_REDIRECT_URI=https://devhub.example.com/devhub/auth/callback
NEXT_PUBLIC_OIDC_ISSUER_URL=https://devhub.example.com/devhub/auth/keycloak/realms/devhub
NEXT_PUBLIC_OIDC_CLIENT_ID=devhub-frontend
NEXT_PUBLIC_OIDC_REDIRECT_URI=https://devhub.example.com/devhub/auth/callback
NEXT_PUBLIC_OIDC_SCOPE=openid offline_access email profile
