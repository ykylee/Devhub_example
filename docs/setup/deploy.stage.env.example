# DevHub stage deploy env template (docker-compose.deploy.yml)
#
# 본 example 은 **stage 환경 = 외부 모드** 가정 (사내 운영팀의 PostgreSQL + Keycloak instance).
# DB_MODE=external (default) + COMPOSE_PROFILES 미설정.
# 분기 매트릭스: docs/setup/internal_network_constraints.md §4 (stage row).
#
# Copy to .env.stage and fill values for your stage environment.

# Image
IMAGE_TAG=replace-with-stage-image-tag
IMAGE_REPO_PREFIX=ghcr.io/ykylee/devhub_example

# Nginx
NGINX_HTTP_PORT=80
DEVHUB_PUBLIC_BASE_URL=https://devhub-stage.example.com

# Mode = external (default, COMPOSE_PROFILES 미설정 = db + Keycloak 컨테이너 미가동)
DB_MODE=external

# Stage commonly uses external Keycloak
KEYCLOAK_UPSTREAM=kc-stage.internal.example.com:8443
# TEST ONLY: allow Keycloak Admin REST from any source IP during deploy/e2e checks.
# Revert to an internal CIDR (for example 10.0.0.0/8) after testing.
KEYCLOAK_ADMIN_ALLOW_CIDR=0.0.0.0/0

# App / DB
DB_URL=postgres://devhub_stage:replace-me@db-stage.internal.example.com:5432/devhub_stage?sslmode=require
BACKEND_API_URL=http://backend-core:8080
BACKEND_AI_URL=http://backend-ai:8000
DEVHUB_AUTH_DEV_FALLBACK=0
# stage 는 운영 정합 — gate enabled (admin pre-seed 동반).
DEVHUB_ONBOARDING_GATE_ENABLED=1
DEVHUB_TRUSTED_PROXIES=172.16.0.0/12

# Project management model (PR #312). stage 는 hybrid 권장 (legacy → v2 점진 전환).
DEVHUB_PROJECT_MODEL=hybrid

# Proxy (사내 환경, optional) — host build / docker daemon 별도 설정 의존
# HTTP_PROXY=http://proxy.internal.example.com:8080
# HTTPS_PROXY=http://proxy.internal.example.com:8080
# NO_PROXY=localhost,127.0.0.1,*.internal.example.com

# OIDC / Keycloak
DEVHUB_IDP_PROVIDER=keycloak
DEVHUB_OIDC_ISSUER_URL=https://devhub-stage.example.com/devhub/auth/keycloak/realms/devhub
DEVHUB_OIDC_CLIENT_ID=devhub-frontend
DEVHUB_OIDC_CLIENT_SECRET=replace-me
DEVHUB_OIDC_AUDIENCE=devhub-frontend
# Recommended when backend cannot resolve/reach public issuer host directly.
DEVHUB_OIDC_JWKS_URL=https://kc-stage.internal.example.com/devhub/auth/keycloak/realms/devhub/protocol/openid-connect/certs
DEVHUB_KEYCLOAK_ADMIN_URL=https://kc-stage.internal.example.com/devhub/auth/keycloak
DEVHUB_KEYCLOAK_ADMIN_REALM=devhub
DEVHUB_KEYCLOAK_ADMIN_CLIENT_ID=devhub-backend
DEVHUB_KEYCLOAK_ADMIN_CLIENT_SECRET=replace-me

# Frontend runtime OIDC
NEXT_PUBLIC_BASE_PATH=devhub
OIDC_ISSUER_URL=https://devhub-stage.example.com/devhub/auth/keycloak/realms/devhub
OIDC_AUTH_URL=
OIDC_REDIRECT_URI=https://devhub-stage.example.com/devhub/auth/callback
NEXT_PUBLIC_OIDC_ISSUER_URL=https://devhub-stage.example.com/devhub/auth/keycloak/realms/devhub
NEXT_PUBLIC_OIDC_CLIENT_ID=devhub-frontend
NEXT_PUBLIC_OIDC_REDIRECT_URI=https://devhub-stage.example.com/devhub/auth/callback
NEXT_PUBLIC_OIDC_SCOPE=openid offline_access email profile
