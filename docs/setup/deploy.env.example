# DevHub deploy env template (docker-compose.deploy.yml)
# Copy to .env (or pass via CI secret/env manager) and fill secrets before deploy.

# Image
IMAGE_TAG=replace-with-git-sha-or-release-tag
IMAGE_REPO_PREFIX=ghcr.io/ykylee/devhub_example

# External access (client -> host -> VM)
PUBLIC_ACCESS_SCHEME=http
PUBLIC_ACCESS_HOST=100.90.113.29
PUBLIC_ACCESS_PORT=13000
# Optional override: set the full external base URL directly instead of PUBLIC_ACCESS_*
DEVHUB_PUBLIC_BASE_URL=

# VM ingress / nginx in guest
NGINX_HTTP_PORT=3000
KEYCLOAK_UPSTREAM=keycloak:8080
KEYCLOAK_ADMIN_ALLOW_CIDR=127.0.0.1

# App / DB
DB_URL=postgres://user:pass@db:5432/devhub?sslmode=disable
BACKEND_API_URL=http://backend-core:8080
BACKEND_AI_URL=http://backend-ai:8000
DEVHUB_AUTH_DEV_FALLBACK=0
DEVHUB_TRUSTED_PROXIES=172.16.0.0/12

# OIDC / Keycloak (required in all modes)
DEVHUB_IDP_PROVIDER=keycloak
DEVHUB_OIDC_ISSUER_URL=https://devhub.example.com/devhub/auth/keycloak/realms/devhub
DEVHUB_OIDC_CLIENT_ID=devhub-frontend
DEVHUB_OIDC_CLIENT_SECRET=replace-me
DEVHUB_OIDC_AUDIENCE=devhub-frontend
# Optional but recommended when issuer URL is public and backend cannot reach that host directly.
# Example: DEVHUB_OIDC_JWKS_URL=http://keycloak:8080/devhub/auth/keycloak/realms/devhub/protocol/openid-connect/certs
DEVHUB_OIDC_JWKS_URL=
DEVHUB_KEYCLOAK_ADMIN_URL=http://keycloak:8080/devhub/auth/keycloak
DEVHUB_KEYCLOAK_ADMIN_REALM=devhub
DEVHUB_KEYCLOAK_ADMIN_CLIENT_ID=devhub-backend
DEVHUB_KEYCLOAK_ADMIN_CLIENT_SECRET=replace-me

# Frontend runtime OIDC
NEXT_PUBLIC_BASE_PATH=devhub
OIDC_ISSUER_URL=https://devhub.example.com/devhub/auth/keycloak/realms/devhub
OIDC_AUTH_URL=
OIDC_REDIRECT_URI=https://devhub.example.com/devhub/auth/callback
NEXT_PUBLIC_OIDC_ISSUER_URL=https://devhub.example.com/devhub/auth/keycloak/realms/devhub
NEXT_PUBLIC_OIDC_CLIENT_ID=devhub-frontend
NEXT_PUBLIC_OIDC_REDIRECT_URI=https://devhub.example.com/devhub/auth/callback
NEXT_PUBLIC_OIDC_SCOPE=openid offline_access email profile

# --- Local Keycloak profile only (when using --profile local-idp) ---
KEYCLOAK_HOSTNAME=devhub.example.com
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=replace-me
KC_DB_URL=jdbc:postgresql://db:5432/devhub
KC_DB_USERNAME=user
KC_DB_PASSWORD=pass
KC_DB_SCHEMA=keycloak
KC_HOSTNAME_STRICT=false
KC_HOSTNAME_STRICT_HTTPS=false
KC_HTTP_RELATIVE_PATH=/devhub/auth/keycloak
KC_LOG_LEVEL=INFO
KEYCLOAK_REALM_IMPORT_PATH=./infra/idp/keycloak-realm.dev.json
