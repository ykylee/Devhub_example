# DevHub deploy env template (docker-compose.deploy.yml)
#
# 본 example 은 **개발자 로컬 / 사내 dev VM** 시나리오의 두 모드 분기를 포함한다:
#   - 내부 모드: compose 가 PostgreSQL + Keycloak 컨테이너 가동 (DB_MODE=docker + COMPOSE_PROFILES=local-db,local-idp)
#   - 외부 모드: 사내 운영팀의 PostgreSQL + Keycloak instance 연결 (DB_MODE=external + DB_URL/KEYCLOAK_UPSTREAM 명시)
#
# 분기 매트릭스: docs/setup/internal_network_constraints.md §4
# 자세한 절차:    docs/setup/docker-packaging-deployment-guide.md (메인 가이드)
# 사내 네트워크: docs/setup/internal_network_constraints.md (3 제약 통합)
#
# Copy to .env (or pass via CI secret/env manager) and fill secrets before deploy.

# ===== 1. 공통 =====

# Image
IMAGE_TAG=replace-with-git-sha-or-release-tag
IMAGE_REPO_PREFIX=ghcr.io/ykylee/devhub_example

# External access (외부 client → 호스트 → VM, internal_network_constraints.md §2)
# - PUBLIC_ACCESS_PORT: 호스트 머신의 외부 진입 port (가변).
#   사내 dev VM default 13000 / staging 또는 prod 단일 포트 reverse proxy 시 443 / 사내 다른 환경 자유.
# - NGINX_HTTP_PORT: VM 내부 nginx 의 host bind port (가변).
#   사내 dev VM default 3000 / staging 또는 prod 시 80 (단일 포트 reverse proxy 정공법).
# - host 의 PUBLIC_ACCESS_PORT ↔ VM 의 NGINX_HTTP_PORT forward 는 사내 인프라 측 별도
#   설정 의존 (SSH tunnel / NAT / iptables 등). compose 자체는 NGINX_HTTP_PORT 의 host
#   bind 만 처리. 자세한 가변 사례 매트릭스: internal_network_constraints.md §2.4.
PUBLIC_ACCESS_SCHEME=http
PUBLIC_ACCESS_HOST=100.90.113.29
PUBLIC_ACCESS_PORT=13000
# Optional override: set the full external base URL directly instead of PUBLIC_ACCESS_*
DEVHUB_PUBLIC_BASE_URL=

# VM ingress / nginx in guest (VM 내부 nginx 가 host 에 bind 하는 port, 가변)
NGINX_HTTP_PORT=3000
KEYCLOAK_ADMIN_ALLOW_CIDR=127.0.0.1/32

# App
BACKEND_API_URL=http://backend-core:8080
BACKEND_AI_URL=http://backend-ai:8000
DEVHUB_AUTH_DEV_FALLBACK=0
# Onboarding gate (ADR-0021 §3.3). 운영은 1 유지. 내부 Keycloak 테스트 시 0 으로
# 두면 admin pre-seed 없이 Keycloak 계정으로 자유 사용 가능 (frontend 는 첫 진입
# 시 /onboarding → Skip 1회 클릭 필요).
DEVHUB_ONBOARDING_GATE_ENABLED=1
DEVHUB_TRUSTED_PROXIES=172.16.0.0/12

# Project management model (PR #312, codex/work_260526-a-project-management-enhancement)
# hybrid (default 권장) = v1 legacy + v2 v2-only 동시 운영 / legacy = 기존만 / v2 = 신규만
DEVHUB_PROJECT_MODEL=hybrid

# Frontend basePath
NEXT_PUBLIC_BASE_PATH=devhub

# ===== 2. proxy (사내 환경, optional) =====
# host build 단계 (build-artifacts.sh: go / npm / pip) 에서 자동 전파.
# docker build 단계 의 base image pull 은 별도 ~/.docker/config.json proxy 또는
# Dockerfile FROM ARG override (docs §5.1 사내 mirror) 활용.
# HTTP_PROXY=http://proxy.internal.example.com:8080
# HTTPS_PROXY=http://proxy.internal.example.com:8080
# NO_PROXY=localhost,127.0.0.1,*.internal.example.com

# ===== 3. 모드 분기 — 둘 중 하나 선택 =====
#
# ---- 3-A. 내부 모드 (compose 가 db + Keycloak 가동) ----
# DB_MODE=docker
# COMPOSE_PROFILES=local-db,local-idp
# POSTGRES_USER=user
# POSTGRES_PASSWORD=pass
# POSTGRES_DB=devhub
# KC_BOOTSTRAP_ADMIN_USERNAME=admin
# KC_BOOTSTRAP_ADMIN_PASSWORD=replace-me
# DB_URL 은 deploy-from-env.sh 가 자동 생성 (postgres://user:pass@db:5432/devhub)
# KEYCLOAK_UPSTREAM 은 'keycloak:8080' default 그대로 사용
# DEVHUB_OIDC_JWKS_URL 은 compose internal DNS (http://nginx/...) 자동 사용
# KEYCLOAK_REALM_IMPORT_PATH 는 deploy-from-env.sh 가 자동 emit (./infra/idp/keycloak-realm.dev.json)
#
# ---- 3-B. 외부 모드 (사내 운영팀의 db + Keycloak 연결, default) ----
DB_MODE=external
DB_URL=postgres://user:pass@db:5432/devhub?sslmode=disable
KEYCLOAK_UPSTREAM=keycloak:8080
# 외부 mode 의 KEYCLOAK_REALM_IMPORT_PATH 는 emit 안 됨 (PR #304 emit gate) —
# 외부 Keycloak 은 사내 운영팀이 realm 자체 발급 (infra/idp/README.md §2.2).

# ===== 4. OIDC / Keycloak (모든 모드 공통) =====
DEVHUB_IDP_PROVIDER=keycloak
DEVHUB_OIDC_ISSUER_URL=https://devhub.example.com/devhub/auth/keycloak/realms/devhub
DEVHUB_OIDC_CLIENT_ID=devhub-frontend
DEVHUB_OIDC_CLIENT_SECRET=replace-me
DEVHUB_OIDC_AUDIENCE=devhub-frontend
# Optional but recommended when issuer URL is public and backend cannot reach that host directly.
# Example: DEVHUB_OIDC_JWKS_URL=http://keycloak:8080/devhub/auth/keycloak/realms/devhub/protocol/openid-connect/certs
DEVHUB_OIDC_JWKS_URL=
DEVHUB_KEYCLOAK_ADMIN_URL=http://keycloak:8080/devhub/auth/keycloak
DEVHUB_KEYCLOAK_ADMIN_REALM=devhub
DEVHUB_KEYCLOAK_ADMIN_CLIENT_ID=devhub-backend
DEVHUB_KEYCLOAK_ADMIN_CLIENT_SECRET=replace-me

# ===== 5. Frontend runtime OIDC =====
OIDC_ISSUER_URL=https://devhub.example.com/devhub/auth/keycloak/realms/devhub
OIDC_AUTH_URL=
OIDC_REDIRECT_URI=https://devhub.example.com/devhub/auth/callback
NEXT_PUBLIC_OIDC_ISSUER_URL=https://devhub.example.com/devhub/auth/keycloak/realms/devhub
NEXT_PUBLIC_OIDC_CLIENT_ID=devhub-frontend
NEXT_PUBLIC_OIDC_REDIRECT_URI=https://devhub.example.com/devhub/auth/callback
NEXT_PUBLIC_OIDC_SCOPE=openid offline_access email profile

# ===== 6. Local Keycloak profile only (내부 모드 = COMPOSE_PROFILES 에 local-idp 포함 시) =====
KEYCLOAK_HOSTNAME=devhub.example.com
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=replace-me
KC_DB_URL=jdbc:postgresql://db:5432/devhub
KC_DB_USERNAME=user
KC_DB_PASSWORD=pass
KC_DB_SCHEMA=keycloak
DEVHUB_KEYCLOAK_SSL_REQUIRED=none
KC_HOSTNAME_STRICT=false
KC_HOSTNAME_STRICT_HTTPS=false
KC_HTTP_RELATIVE_PATH=/devhub/auth/keycloak
KC_LOG_LEVEL=INFO
KEYCLOAK_REALM_IMPORT_PATH=./infra/idp/keycloak-realm.dev.json
