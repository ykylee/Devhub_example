#!/usr/bin/env bash
# wiki-query — 본 저장소 (= DevHub) 측 thin wrapper.
# SSOT: ~/repos/my_harness/ai-workflow/skills/wiki-query/scripts/run_wiki_query.py
# (D-79/D-81 T-d-79-2, handoff §2 의 6 file 중 2, my_harness 의 cross-project SSOT).
#
# 사용:
#   bash ai-workflow/skills/wiki-query/scripts/wiki-query \
#     --query "<text>" [--project=devhub|my-harness] [--file]
#
# 본 wrapper 는 단순히 my_harness 의 Python SSOT 호출.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
MYHARNESS_ROOT="${MYHARNESS_ROOT:-$HOME/repos/my_harness}"
SSOT_PY="$MYHARNESS_ROOT/ai-workflow/skills/wiki-query/scripts/run_wiki_query.py"

if [[ ! -f "$SSOT_PY" ]]; then
  echo "ERROR: my_harness SSOT 부재: $SSOT_PY" >&2
  echo "  hint: my_harness 측 wiki-query skill 작성 필요 (D-79/D-81)." >&2
  exit 1
fi

exec python3 "$SSOT_PY" "$@"
