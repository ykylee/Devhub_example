#!/usr/bin/env bash
# wiki-event-sync — 본 저장소 (= DevHub) 측 thin wrapper.
# SSOT: ~/wiki/skills/wiki-event-sync/scripts/wiki-event-sync.py (vault, cross-project).
# 밴치마킹 출처: ~/repos/my_harness/ai-workflow/skills/wiki-event-sync/ (D-86).
#
# 사용:
#   bash ai-workflow/skills/wiki-event-sync/scripts/wiki-event-sync \
#     --op=commit --project=devhub --ref=<sha> [--dry-run]
#   bash ai-workflow/skills/wiki-event-sync/scripts/wiki-event-sync \
#     --op=pr --project=devhub --ref=<PR#> --repo=ykylee/Devhub_example
#
# 본 wrapper 는 단순히 vault 의 SSOT Python 호출.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VAULT_PY="$HOME/wiki/skills/wiki-event-sync/scripts/wiki-event-sync.py"

if [[ ! -f "$VAULT_PY" ]]; then
  echo "ERROR: vault SSOT 부재: $VAULT_PY" >&2
  echo "  hint: vault 초기화 필요." >&2
  exit 1
fi

# commit op 의 경우 caller cwd 가 git 저장소 안이어야 함
for arg in "$@"; do
  case "$arg" in
    --op=commit)
      if ! git rev-parse --git-dir >/dev/null 2>&1; then
        echo "ERROR: --op=commit 는 git 저장소 안에서 실행 필요" >&2
        exit 1
      fi
      ;;
  esac
done

exec python3 "$VAULT_PY" "$@"
