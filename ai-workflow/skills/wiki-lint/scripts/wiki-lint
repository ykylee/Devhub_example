#!/usr/bin/env bash
# wiki-lint — 본 저장소 (= DevHub) 측 thin wrapper.
# SSOT: ~/repos/my_harness/ai-workflow/skills/wiki-lint/scripts/run_wiki_lint.py
# (my_harness 의 cross-project SSOT, D-71 ~ D-79, L01~L10 + per-project 지원).
#
# 사용:
#   bash ai-workflow/skills/wiki-lint/scripts/wiki-lint \
#     --vault-path ~/wiki --project=devhub \
#     --project-config=docs/llm-wiki/lint-config.toml
#
# 본 wrapper 는 단순히 my_harness 의 Python SSOT 호출. read-only.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
MYHARNESS_ROOT="${MYHARNESS_ROOT:-$HOME/repos/my_harness}"
SSOT_PY="$MYHARNESS_ROOT/ai-workflow/skills/wiki-lint/scripts/run_wiki_lint.py"

if [[ ! -f "$SSOT_PY" ]]; then
  echo "ERROR: my_harness SSOT 부재: $SSOT_PY" >&2
  echo "  hint: my_harness 측 wiki-lint skill 작성 필요 (D-71 ~ D-79)." >&2
  exit 1
fi

exec python3 "$SSOT_PY" "$@"
