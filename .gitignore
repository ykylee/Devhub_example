.env
.env.*
!.env.example
!.env.template
!**/.env.example
!**/.env.template

# === WORKFLOW KIT START ===
# Workflow layer (selective tracking)
/ANTIGRAVITY.md
/AGENTS.md
/GEMINI.md
/CLAUDE.md
/.claude/

# Exclude duplicated engine/tool copies
/ai-workflow/scripts/
/ai-workflow/skills/
/ai-workflow/workflow_kit/
/ai-workflow/mcp_servers/
/ai-workflow/schemas/
/ai-workflow/templates/
/ai-workflow/examples/
/ai-workflow/global-snippets/
/ai-workflow/harnesses/
/ai-workflow/tests/

# Keep the data (memory) and core guides
!/ai-workflow/README.md
!/ai-workflow/WORKFLOW_INDEX.md
!/ai-workflow/core/
!/ai-workflow/memory/
# === WORKFLOW KIT END ===

.venv/
__pycache__/
node_modules/
.next/
dist/
build/
*.log

# dev-up.sh / dev-down.sh runtime PID files
.pids/

# AI agent / test artifacts (generated during development)
.omo/
.playwright-mcp/
keycloak-login.yml

# dev-up build outputs (go build target for backend-core)
dev-bin/

# backend-core local build artifacts (go build ./... 산출물)
backend-core/bin/

# backend-ai host build artifacts
backend-ai/.build/

# repo-root build outputs (deploy-from-env.sh generated realm import,
# generate_local_realm_import() 의 $ROOT_DIR/.build/devhub-keycloak-realm.generated.json
# 등). 직전 /tmp/* 는 tmpfs / Docker Desktop mount 제한 호스트에서 container 재시작
# 시 사라지는 risk 있어 repo 안 안정 path 로 이전.
/.build/

# === DEV ENVIRONMENT (machine-specific, mostly untracked) ===
# 컨테이너 런타임 산출물, 로컬 오버라이드, 비밀값은 추적하지 않는다.
# Dockerfile 은 배포/빌드 계약의 일부이므로 git 에 포함한다.
docker-compose.yml
docker-compose.*.yml
!docker-compose.deploy.yml
!docker-compose.colima.yml
**/.dockerignore
# docker-only IdP configs (hostnames hardcoded to docker-compose service names)
infra/idp/*.docker.yaml
infra/nginx/certs/

# auto-generated nginx conf (rendered from devhub.deploy.conf.template by
# scripts/nginx-conf-sync.sh; docker deploy uses the .template directly via
# nginx official image's envsubst entrypoint)
infra/nginx/devhub.deploy.conf

# === TEST ARTIFACTS ===
# Playwright 산출물 — frontend/.gitignore 는 frontend 하위만 커버. repo 루트에서
# `playwright test` 실행 시 생기는 산출물(.last-run.json 등) 재발 방지.
/test-results/
/playwright-report/

# === EDITOR / OS NOISE ===
.DS_Store
**/.DS_Store
*.bak
*.swp
Thumbs.db
docs/LOCAL_MACHINE_ENV.md
# Antigravity CLI 세션 아티팩트 (UUID.json) — 에디터 부산물, 커밋 금지.
.antigravitycli/

.reasonix/

# Mavis/MiniMax 세션 scratch
.local/

# Gemini temp files
scratch/
ui-screenshots-shard-2/

# === TIER SEPARATION (2026-06-10) ===
# 사내 한정 (tier=internal) 인프라 운영 산출물 / 설정 파일. 사외 build 시
# 추적 안 함. 이미 history 에 들어간 사내 한정 파일은 §4.2 ADR immutable
# history 정책에 따라 force-remove 하지 않음 (사내 SCM 으로 별도 migration).
# 신규 사내 한정 파일이 본 패턴 매칭 시 GitHub push 자동 차단.
# 정책: docs/governance/worker_division.md §6.3.3

# 사내 deploy compose (172.16.0.0/12 + kc.internal.example.com)
/docker-compose.deploy.yml

# 사내 prod Keycloak realm (실제 redirect URI)
/infra/idp/keycloak-realm.prod.json

# 사내 운영 스크립트 (Keycloak admin / nginx sync / HRDB ETL / dogfood)
/scripts/setup-keycloak.sh
/scripts/verify-keycloak-groups.sh
/scripts/deploy-from-env.sh
/scripts/deploy-preflight.sh
/scripts/deploy-up.sh
/scripts/nginx-conf-sync.sh
/scripts/hrdb_etl_sync.sh
/scripts/hrdb_etl_seed.sql
/scripts/dogfood.sh
/scripts/dogfood-create-user.sh

# 사내 deploy env template (devhub.example.com / kc.internal.example.com)
/docs/setup/deploy.env.example
/docs/setup/deploy.stage.env.example
/docs/setup/deploy.prod.env.example

# 사내 dogfood 가이드 (사내 staging / Keycloak 직접 참조)
/docs/dogfood/

# 사내 staging/operation reports
/docs/reports/
/docs/analysis/

# 사내 Keycloak SPI plugin build 산출물 (Java jar)
/infra/idp/keycloak-event-listener-spi/target/
/infra/idp/keycloak-event-listener-spi/build/

# 사내 nginx certs + rendered conf
/infra/nginx/certs/
/infra/nginx/devhub.deploy.conf
# 사내 nginx private keys (절대 추적 금지)
/infra/nginx/*.key
/infra/nginx/*.pem

# 사내 build 산출물 (deploy-from-env.sh / docker image build)
/.build/
/docker-bin/
/dev-bin/
/backend-core/bin/
/backend-ai/.build/

# 사내 compose (docker-compose.colima.yml + localports override 는 사외
# generic 이므로 추적 유지, deploy/local/test 는 사내)
/docker-compose.local.yml
/docker-compose.test.yml
/docker-compose.override.localports.yml

# 사내 host build artifacts
/devhub-backend
/backend-core/devhub-backend
/backend-core/devhub-backend-*

# 사내 .env (prod / stage / deploy)
/.env.deploy
/.env.prod
/.env.stage
/.env.local
/.env.test
!/frontend/.env.example
!/frontend/.env.template
!/docs/setup/.env.example
